# Redfox runtime configuration. Copy to .env for docker compose.

# HTTP port (default 3000)
PORT=3000

# Data root: SQLite databases, published artefacts, uploaded objects
REDFOX_DATA_DIR=./data

# Build workspace root. Keep it outside the application tree so npm cannot
# resolve Redfox own package.json from a project workspace.
REDFOX_BUILD_DIR=/tmp/redfox-builds

# Key material for AES-256-GCM encryption of environment values, API keys and
# webhook secrets. Generate with: openssl rand -hex 32
REDFOX_SECRET_KEY=

# Per-command build timeout in milliseconds (default 180000)
REDFOX_BUILD_TIMEOUT_MS=180000

# Optional hosted model for Solene. Gemini is preferred when multiple keys are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
REDFOX_MODEL=

# Optional Docker engine for real container controls.
DOCKER_HOST=
