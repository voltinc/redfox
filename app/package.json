{
  "name": "redfox",
  "version": "0.9.0",
  "private": true,
  "description": "Redfox — the all-in-one developer cloud. Git, deploys, databases, storage and infrastructure in one platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node server/index.js",
    "build": "npm --prefix web run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js --force",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "lucide-react": "^0.454.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
